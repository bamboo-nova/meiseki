{
  "name": "meiseki",
  "version": "0.1.0",
  "private": true,
  "description": "日本語ドキュメントの読解負荷を textlint で検出し、明晰さだけを目的にリライトする Agent Skill の決定論層。",
  "scripts": {
    "lint": "npx --min-release-age=7 --yes --package textlint@14.8.4 --package textlint-rule-preset-ja-technical-writing@10.0.2 textlint -c skills/meiseki/references/textlint.config.json -f json"
  }
}
