{
  // meiseki 同梱の markdownlint 設定（リグレッションガード用の最小セット）。
  // 方針: "default": false で全ルールを無効化し、「無言の崩れ」
  // （レンダリングして初めて気づく構文の壊れ）の検出に直結するルールだけ有効化する。
  //
  // 意図的に無効のままにしているルール:
  // - MD013（行長）: 散文をハードラップしない方針（1 行 = 1 段落）と衝突するため
  // - MD041（先頭行は h1）: meiseki は「本文だけ返す」仕様のため、文書断片に誤爆するため
  //
  // ルールセットは examples/ の実文書で較正して調整してよい。
  "default": false,

  // 見出しレベルは 1 ずつ増える（h1 → h3 の飛びを検出）
  "MD001": true,
  // リスト記号（- / * / +）は文書内で統一
  "MD004": true,
  // 同一階層のリストはインデントを揃える
  "MD005": true,
  // 行末スペースの禁止（改行強制の 2 スペースだけ許容）
  "MD009": { "br_spaces": 2 },
  // ハードタブの禁止（コードブロック内は除く。Go 等はタブが正なので誤爆する）
  "MD010": { "code_blocks": false },
  // リンク記法の逆転 (text)[url] を検出
  "MD011": true,
  // 見出し # の後にスペースがない行を検出（見出しが平文になる崩れ）
  "MD018": true,
  // 見出し # の後の複数スペースを検出
  "MD019": true,
  // 見出しの前後に空行を置く（前行と連結される崩れを防ぐ）
  "MD022": true,
  // コードフェンスの前後に空行を置く（フェンスが本文と連結される崩れを防ぐ）
  "MD031": true,
  // リストの前後に空行を置く（リストが段落に埋もれる崩れを防ぐ）
  "MD032": true,
  // 空リンク []() を検出
  "MD042": true,
  // ファイル末尾は改行 1 つで終わる
  "MD047": true
}
